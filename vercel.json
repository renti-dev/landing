{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/features/small-landlord-app",
      "destination": "/features/room-management",
      "permanent": true
    },
    {
      "source": "/features/small-landlord-app.html",
      "destination": "/features/room-management",
      "permanent": true
    },
    {
      "source": "/index.php",
      "destination": "https://www.landy.co.kr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "landy.co.kr"
        }
      ],
      "destination": "https://www.landy.co.kr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "landing.landy.co.kr"
        }
      ],
      "destination": "https://www.landy.co.kr/:path*",
      "permanent": true
    }
  ]
}
